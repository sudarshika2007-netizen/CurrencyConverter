import unittest

from src.converter import convert_currency


class TestCurrencyConverter(unittest.TestCase):

    def setUp(self):
        self.rates = {
            "USD": 1.0,
            "INR": 95.24,
            "EUR": 0.85,
            "GBP": 0.74
        }

    # Happy path tests

    def test_usd_to_inr(self):
        result = convert_currency(100, "USD", "INR", self.rates)
        self.assertAlmostEqual(result, 9524.0, places=2)

    def test_inr_to_usd(self):
        result = convert_currency(9524, "INR", "USD", self.rates)
        self.assertAlmostEqual(result, 100.0, places=2)

    def test_usd_to_eur(self):
        result = convert_currency(100, "USD", "EUR", self.rates)
        self.assertAlmostEqual(result, 85.0, places=2)

    # Edge and failure tests

    def test_zero_amount(self):
        result = convert_currency(0, "USD", "INR", self.rates)
        self.assertEqual(result, 0)

    def test_negative_amount(self):
        with self.assertRaises(ValueError):
            convert_currency(-100, "USD", "INR", self.rates)

    def test_unsupported_source_currency(self):
        with self.assertRaises(ValueError):
            convert_currency(100, "XYZ", "INR", self.rates)

    def test_unsupported_target_currency(self):
        with self.assertRaises(ValueError):
            convert_currency(100, "USD", "XYZ", self.rates)


if __name__ == "__main__":
    unittest.main()
